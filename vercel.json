{
  "redirects": [
    { "source": "/Nanu.dc.html", "destination": "/", "permanent": true },
    { "source": "/Daftar-Nama.dc.html", "destination": "/daftar-nama", "permanent": true },
    { "source": "/Nama-Tersimpan.dc.html", "destination": "/nama-tersimpan", "permanent": true },
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "nanu-rust.vercel.app" }],
      "destination": "https://inspirasinama.xyz/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/Nanu.dc.html" },
    { "source": "/daftar-nama", "destination": "/Daftar-Nama.dc.html" },
    { "source": "/nama-tersimpan", "destination": "/Nama-Tersimpan.dc.html" }
  ]
}
